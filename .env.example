# Vorlage für lokale Einstellungen des Lagebild-Dashboards.
# Zum Verwenden diese Datei nach ".env" kopieren und die Werte anpassen:
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env
# Die .env wird beim Bauen bzw. Starten (npm run build / npm run dev) gelesen
# und nicht ins Repository übernommen (.gitignore).

# Beispielwarnungen in der Warnungen-Kachel anzeigen, auch wenn gerade keine
# echte amtliche Warnung für Berlin aktiv ist.
#   0     = aus (Normalbetrieb, echte Warnungen von NINA/BBK)
#   1 – 3 = so viele Beispielwarnungen (nur zum Testen/Vorführen, nie für das
#           veröffentlichte Dashboard; ab 2 sieht man das Blättern im Fenster)
DASHBOARD_TEST_WARNING=0
