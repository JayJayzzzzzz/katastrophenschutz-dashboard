---
// Katastrophenschutz Berlin — Lagebild-Dashboard
// Statische Astro-Seite; die meisten Live-Daten werden im Browser nachgeladen
// (siehe src/scripts/dashboard.js) — passt zu einem reinen GitHub-Pages-Hosting.
//
// Die amtlichen Warnungen (NINA/BBK) sind die eine Ausnahme: deren API hat
// kein CORS und lässt sich daher nicht per Browser-Fetch abrufen. Sie werden
// stattdessen HIER, im Astro-Frontmatter, beim Bauen der Seite geladen
// (serverseitig in Node — CORS betrifft nur Browser) und als fertiges HTML
// ausgeliefert. Der GitHub-Actions-Workflow baut die Seite deshalb auch nach
// einem Zeitplan neu, damit die Warnungen halbwegs aktuell bleiben.

const NINA_AGS = "110000000000"; // Berlin, Bundesland-Ebene

const SEVERITY_STATUS: Record<string, { cls: string; label: string }> = {
	Extreme: { cls: "aqi-critical", label: "Extrem" },
	Severe: { cls: "aqi-serious", label: "Schwer" },
	Moderate: { cls: "aqi-warning", label: "Mittel" },
	Minor: { cls: "aqi-good", label: "Gering" },
};
const SEVERITY_ORDER: Record<string, number> = { Extreme: 4, Severe: 3, Moderate: 2, Minor: 1 };

function formatDe(iso: string | null | undefined) {
	if (!iso) return "–";
	return new Date(iso).toLocaleString("de-DE", { day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit" }) + " Uhr";
}

interface Warning {
	id: string;
	headline: string;
	severity: string;
	senderName: string;
	onset: string | null;
	expires: string | null;
	description: string;
	instruction: string | null;
	areaDesc: string | null;
}

let warnings: Warning[] = [];
let warningsError = false;

try {
	const listRes = await fetch(`https://warnung.bund.de/api31/dashboard/${NINA_AGS}.json`);
	if (!listRes.ok) throw new Error(`Dashboard-Liste: HTTP ${listRes.status}`);
	const list: any[] = await listRes.json();

	const details = await Promise.all(
		list.slice(0, 12).map(async (entry: any): Promise<Warning | null> => {
			try {
				const res = await fetch(`https://warnung.bund.de/api31/warnings/${encodeURIComponent(entry.id)}.json`);
				if (!res.ok) return null;
				const detail: any = await res.json();
				const info = (detail.info || []).find((i: any) => i.language?.startsWith("de")) || detail.info?.[0];
				if (!info) return null;
				return {
					id: entry.id,
					headline: info.headline,
					severity: info.severity,
					senderName: info.senderName,
					onset: info.onset,
					expires: info.expires,
					description: info.description,
					instruction: info.instruction,
					areaDesc: info.area?.[0]?.areaDesc,
				};
			} catch {
				return null;
			}
		})
	);

	warnings = (details.filter(Boolean) as Warning[]).sort(
		(a, b) => (SEVERITY_ORDER[b.severity] || 0) - (SEVERITY_ORDER[a.severity] || 0)
	);
} catch (error) {
	console.error("NINA-Warnungen konnten beim Build nicht geladen werden:", error);
	warningsError = true;
}

if (process.env.DASHBOARD_TEST_WARNING === "1") {
	warnings = [
		{
			id: "test-1",
			severity: "Severe",
			headline: "Amtliche WARNUNG vor STURMBÖEN",
			senderName: "Deutscher Wetterdienst",
			onset: new Date().toISOString(),
			expires: new Date(Date.now() + 3600_000).toISOString(),
			description: "Es treten Sturmböen mit Geschwindigkeiten um 65 km/h auf.",
			instruction: "Objekte sichern.<br/>Vorsicht bei herabfallenden Ästen.",
			areaDesc: "Berlin",
		},
	];
}

const buildStamp = new Date().toLocaleString("de-DE", { day: "2-digit", month: "2-digit", year: "numeric", hour: "2-digit", minute: "2-digit" });

const warningsStatus = warningsError
	? { cls: "", label: "Keine Daten" }
	: warnings.length > 0
		? SEVERITY_STATUS[warnings[0].severity] || SEVERITY_STATUS.Minor
		: { cls: "aqi-good", label: "Keine aktiv" };
---

<html lang="de">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
	<meta name="generator" content={Astro.generator} />
	<meta name="description" content="Lagebild-Dashboard des Katastrophenschutz Berlin: Wetter, Pegelstand der Spree, Brandeinsätze, Luftqualität und 7-Tage-Vorhersage auf einen Blick." />
	<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700;6..12,800&display=swap" />
	<title>Lagebild-Dashboard · Katastrophenschutz Berlin</title>
</head>
<body>
	<svg width="0" height="0" style="position:absolute" aria-hidden="true">
		<defs>
			<symbol id="i-pin" viewBox="0 0 24 24"><path d="M12 21s7-6.6 7-12a7 7 0 1 0-14 0c0 5.4 7 12 7 12z"/><circle cx="12" cy="9" r="2.4"/></symbol>
			<symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></symbol>
			<symbol id="i-drop" viewBox="0 0 24 24"><path d="M12 3s6.5 7 6.5 11.5A6.5 6.5 0 1 1 5.5 14.5C5.5 10 12 3 12 3z"/></symbol>
			<symbol id="i-flame" viewBox="0 0 24 24"><path d="M12 2.5c1 3-3 4.3-3 7.6a3 3 0 0 0 6 0c0-1.1-.9-1.6-.9-2.7 1.6 1.1 3.4 3.3 3.4 6a5.5 5.5 0 1 1-11 0c0-4.6 3.8-7 5.5-10.9z"/></symbol>
			<symbol id="i-wind" viewBox="0 0 24 24"><path d="M3 8h10.5a2.5 2.5 0 1 0-2.3-3.4"/><path d="M3 12.5h13.5a2.7 2.7 0 1 1-2.4 3.6"/><path d="M3 17h7.5"/></symbol>
			<symbol id="i-up" viewBox="0 0 24 24"><path d="M12 19V5"/><path d="M6 11l6-6 6 6"/></symbol>
			<symbol id="i-down" viewBox="0 0 24 24"><path d="M12 5v14"/><path d="M18 13l-6 6-6-6"/></symbol>
			<symbol id="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4.6"/><path d="M12 2.5v2.4M12 19v2.4M4.2 12H1.8M22.2 12h-2.4M5.3 5.3l1.7 1.7M17 17l1.7 1.7M18.7 5.3 17 7M7 17l-1.7 1.7"/></symbol>
			<symbol id="i-cloud" viewBox="0 0 24 24"><path d="M6.5 18h11a4 4 0 0 0 .5-8 5.5 5.5 0 0 0-10.6-1.7A4 4 0 0 0 6.5 18z"/></symbol>
			<symbol id="i-cloud-sun" viewBox="0 0 24 24"><circle cx="8" cy="8" r="3"/><path d="M8 2.6v1.6M8 12v0M3.4 8H2M13.6 6.5 12.3 7.7M3.7 3.7 5 5"/><path d="M9.5 20h9a3.3 3.3 0 0 0 .4-6.6 4.6 4.6 0 0 0-8.8-1.4A3.3 3.3 0 0 0 9.5 20z"/></symbol>
			<symbol id="i-rain" viewBox="0 0 24 24"><path d="M6.5 14h11a4 4 0 0 0 .5-8 5.5 5.5 0 0 0-10.6-1.7A4 4 0 0 0 6.5 14z"/><path d="M8 18.5 7 21M12 18.5l-1 2.5M16 18.5l-1 2.5"/></symbol>
			<symbol id="i-snow" viewBox="0 0 24 24"><path d="M6.5 13h11a4 4 0 0 0 .5-8 5.5 5.5 0 0 0-10.6-1.7A4 4 0 0 0 6.5 13z"/><path d="M8 17v5M6 18.5l4 2M10 18.5l-4 2M16 17v5M14 18.5l4 2M18 18.5l-4 2"/></symbol>
			<symbol id="i-fog" viewBox="0 0 24 24"><path d="M4 9.5h11a3.5 3.5 0 0 0 .3-7A5 5 0 0 0 6 3.6"/><path d="M3 13.5h18M3 17h18M3 20.5h13"/></symbol>
			<symbol id="i-thunder" viewBox="0 0 24 24"><path d="M6.5 12h11a4 4 0 0 0 .5-8 5.5 5.5 0 0 0-10.6-1.7A4 4 0 0 0 6.5 12z"/><path d="m13 12-3 5h3l-2 5 6-7h-3z"/></symbol>
			<symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3l7 3v5.5c0 4.6-3 8.2-7 9.5-4-1.3-7-4.9-7-9.5V6l7-3z"/><path d="M9 12l2 2 4-4"/></symbol>
			<symbol id="i-chevron" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></symbol>
			<symbol id="i-close" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></symbol>
			<symbol id="i-alert" viewBox="0 0 24 24"><path d="M12 3.5 21.5 20h-19L12 3.5z"/><path d="M12 10v4.2"/><circle cx="12" cy="17.3" r="0.6" fill="currentColor" stroke="none"/></symbol>
			<symbol id="i-stopwatch" viewBox="0 0 24 24"><circle cx="12" cy="13" r="8"/><path d="M12 13l3-2"/><path d="M9 2h6"/><path d="M12 2v2"/></symbol>
			<symbol id="i-siren" viewBox="0 0 24 24"><path d="M12 4a5 5 0 0 1 5 5v3H7V9a5 5 0 0 1 5-5z"/><path d="M5 15.5h14l1 4.5H4l1-4.5z"/><path d="M12 2v1"/></symbol>
			<symbol id="i-map" viewBox="0 0 24 24"><path d="M9 4 4 6v14l5-2 6 2 5-2V4l-5 2-6-2z"/><path d="M9 4v14M15 6v14"/></symbol>
		</defs>
	</svg>

	<main class="screen">
		<div class="layout">
			<div class="area-top">
				<div class="place"><svg class="ic"><use href="#i-pin"/></svg>Berlin, DE</div>
				<div class="timestamp">
					<svg class="ic"><use href="#i-clock"/></svg>
					<span id="liveDate">–</span> · <span id="liveClock">--:--:--</span> Uhr
					<span class="live-dot" aria-hidden="true"></span>
				</div>
			</div>

			<section class="hero-block" aria-label="Aktuelles Wetter und Luftqualität">
				<div class="hero-top">
					<div class="temp-big"><span id="temperature">--°</span></div>
					<div class="hero-icon-col">
						<svg class="hero-icon" id="heroIcon"><use href="#i-cloud"/></svg>
						<div class="air-badge" title="Luftqualität">
							<svg class="ic" id="aqiIcon"><use href="#i-shield"/></svg>
							<span id="aqiValue">--</span>
						</div>
					</div>
				</div>
				<div class="cond" id="description">Wetter wird geladen …</div>
				<div class="minmax">
					<svg class="ic"><use href="#i-down"/></svg><strong id="tempMin">--°</strong>
					<svg class="ic"><use href="#i-up"/></svg><strong id="tempMax">--°</strong>
				</div>
				<div class="chips">
					<span class="chip"><svg class="ic sm"><use href="#i-wind"/></svg><span id="chipWind">-- km/h</span></span>
					<span class="chip">Böen <span id="chipGust">-- km/h</span></span>
					<span class="chip"><svg class="ic sm"><use href="#i-drop"/></svg><span id="chipHumidity">-- %</span></span>
					<span class="chip">Niederschlag <span id="chipPrecip">-- mm</span></span>
					<span class="chip">Luftdruck <span id="chipPressure">-- hPa</span></span>
					<span class="chip">UV <span id="chipUV">--</span></span>
					<span class="chip"><svg class="ic sm"><use href="#i-sun"/></svg><span id="chipSun">--:-- · --:--</span></span>
					<span class="chip">Luft <span id="aqiDetail">Lädt …</span></span>
				</div>
				<div class="status" id="weatherStatus">Lädt …</div>
			</section>

			<section class="stat s-pegel" aria-label="Pegelstand Spree Berlin-Köpenick, 48-Stunden-Verlauf">
				<div class="k"><svg class="ic"><use href="#i-drop"/></svg>Pegel Spree · Köpenick</div>
				<div class="v" id="pegelValue">-- cm</div>
				<div class="sub" id="pegelTrend">Lädt …</div>
				<div class="mini-chart">
					<svg id="pegelChart" aria-hidden="true"></svg>
					<div id="pegelTooltip" class="chart-tooltip" hidden></div>
				</div>
				<div class="sub muted" id="pegelTime"></div>
			</section>

			<section class="stat s-fire" aria-label="Brandeinsätze der Berliner Feuerwehr, 14-Tage-Verlauf">
				<div class="k"><svg class="ic"><use href="#i-flame"/></svg>Brände · 14-Tage-Verlauf</div>
				<div class="v"><span id="fireCount">--</span> <span class="unit">Einsätze</span></div>
				<div class="sub">am <span id="fireDate">--</span></div>
				<div class="mini-chart">
					<svg id="fireChart" aria-hidden="true"></svg>
					<div id="fireTooltip" class="chart-tooltip" hidden></div>
				</div>
			</section>

			<button type="button" class="stat s-warn" id="warningsOpen" aria-haspopup="dialog" aria-label="Amtliche Warnungen, Details öffnen">
				<div class="k"><svg class="ic"><use href="#i-alert"/></svg>Warnungen</div>
				<div class:list={["v", warningsStatus.cls]}>
					{warningsError ? "Keine Daten" : warnings.length > 0 ? `${warnings.length} aktiv` : "Keine aktiv"}
				</div>
				<div class="sub">{warningsError ? "Bund/DWD für Berlin nicht erreichbar" : "Bund/DWD für Berlin"}</div>

				<div class="warn-preview">
					{warningsError ? (
						<p>Warnungen aktuell nicht abrufbar.</p>
					) : warnings.length === 0 ? (
						<p>Keine amtlichen Warnungen (NINA/DWD/BBK) für Berlin.</p>
					) : (
						warnings.slice(0, 3).map((w) => (
							<p class="warn-preview-item">
								<span class:list={["warn-dot", (SEVERITY_STATUS[w.severity] || SEVERITY_STATUS.Minor).cls]}></span>
								{w.headline}
							</p>
						))
					)}
				</div>

				<div class="sub muted">Details ansehen</div>
			</button>

			<section class="chart-box" aria-label="24-Stunden-Temperaturverlauf">
				<div class="chart-head"><span>24-Std.-Verlauf</span><b id="chartNow">--°</b></div>
				<div class="chart-wrap">
					<svg id="weatherChart" preserveAspectRatio="none" aria-hidden="true"></svg>
					<div id="chartTooltip" class="chart-tooltip" hidden></div>
				</div>
			</section>

			<section class="stat s-resptime" aria-label="Durchschnittliche Reaktionszeit der Feuerwehr, letzte 30 Tage">
				<div class="k"><svg class="ic"><use href="#i-stopwatch"/></svg>Ø Reaktionszeit (30 Tage)</div>
				<div class="v"><span id="respTimeValue">--</span></div>
				<div class="sub">Eintreffen 1. Löschfahrzeug</div>
				<div class="mini-chart">
					<svg id="respTimeChart" aria-hidden="true"></svg>
					<div id="respTimeTooltip" class="chart-tooltip" hidden></div>
				</div>
			</section>

			<div class="stack-col" style="grid-area: total;">
				<section class="stat tile-half" aria-label="Gesamteinsätze der Berliner Feuerwehr, Vortag">
					<div class="k"><svg class="ic"><use href="#i-siren"/></svg>Gesamteinsätze</div>
					<div class="v"><span id="totalMissionsValue">--</span></div>
					<div class="sub">alle Kategorien · am <span id="fireDate2">--</span></div>
				</section>

				<button type="button" class="stat tile-half tile-half-btn" id="hazardMapOpen" aria-haspopup="dialog">
					<div class="k"><svg class="ic"><use href="#i-map"/></svg>Gefahrenkarte</div>
					<div class="v">Hochwasser</div>
					<div class="sub">Amtliche Karte ansehen</div>
				</button>
			</div>

			<section class="forecast" id="forecastRow" aria-label="7-Tage-Vorhersage, zum Aufklappen antippen"></section>
		</div>
	</main>

	<div class="day-modal" id="dayModal" hidden>
		<div class="day-modal-backdrop" id="dayModalBackdrop"></div>
		<div class="day-modal-panel" role="dialog" aria-modal="true" aria-labelledby="dayModalDate">
			<button class="day-modal-close" id="dayModalClose" aria-label="Schließen">
				<svg class="ic"><use href="#i-close"/></svg>
			</button>
			<div class="day-modal-head">
				<svg class="day-modal-icon" id="dayModalIcon"><use href="#i-cloud"/></svg>
				<div>
					<div class="day-modal-date" id="dayModalDate">–</div>
					<div class="day-modal-cond" id="dayModalCond">–</div>
				</div>
			</div>
			<div class="day-modal-temps">
				<span class="hi"><svg class="ic"><use href="#i-up"/></svg><span id="dayModalHi">--°</span></span>
				<span class="lo"><svg class="ic"><use href="#i-down"/></svg><span id="dayModalLo">--°</span></span>
			</div>
			<div class="day-modal-grid">
				<div class="dm-stat"><div class="dm-k">Niederschlag</div><div class="dm-v" id="dayModalPrecip">--</div></div>
				<div class="dm-stat"><div class="dm-k">Regenwahrscheinlichkeit</div><div class="dm-v" id="dayModalPrecipProb">--</div></div>
				<div class="dm-stat"><div class="dm-k">Wind (max.)</div><div class="dm-v" id="dayModalWind">--</div></div>
				<div class="dm-stat"><div class="dm-k">Böen (max.)</div><div class="dm-v" id="dayModalGust">--</div></div>
				<div class="dm-stat"><div class="dm-k">UV-Index (max.)</div><div class="dm-v" id="dayModalUV">--</div></div>
				<div class="dm-stat"><div class="dm-k">Sonnenauf-/-untergang</div><div class="dm-v" id="dayModalSun">--</div></div>
			</div>
		</div>
	</div>

	<div class="day-modal" id="warnModal" hidden>
		<div class="day-modal-backdrop" id="warnModalBackdrop"></div>
		<div class="day-modal-panel warn-modal-panel" role="dialog" aria-modal="true" aria-labelledby="warnModalTitle">
			<button class="day-modal-close" id="warnModalClose" aria-label="Schließen">
				<svg class="ic"><use href="#i-close"/></svg>
			</button>
			<h2 id="warnModalTitle">Amtliche Warnungen · Berlin</h2>

			{warningsError ? (
				<p class="warn-empty">Die Warnungen (NINA/BBK) konnten beim letzten Build der Seite nicht geladen werden. Das ist keine Aussage darüber, ob gerade eine Warnung besteht — bitte zusätzlich <a href="https://warnung.bund.de" target="_blank" rel="noopener">warnung.bund.de</a> prüfen.</p>
			) : warnings.length === 0 ? (
				<p class="warn-empty">Aktuell liegen keine amtlichen Warnungen (NINA/DWD/BBK) für Berlin vor.</p>
			) : (
				<div class="warn-list">
					{warnings.map((w) => (
						<article class="warn-card">
							<div class="warn-card-head">
								<span class:list={["warn-badge", (SEVERITY_STATUS[w.severity] || SEVERITY_STATUS.Minor).cls]}>
									{(SEVERITY_STATUS[w.severity] || SEVERITY_STATUS.Minor).label}
								</span>
								<span class="warn-time">gültig bis {formatDe(w.expires)}</span>
							</div>
							<h3>{w.headline}</h3>
							{w.description && <p class="warn-desc">{w.description}</p>}
							{w.instruction && <p class="warn-instr" set:html={w.instruction} />}
							<p class="warn-meta">{w.senderName}{w.areaDesc ? ` · ${w.areaDesc}` : ""}</p>
						</article>
					))}
				</div>
			)}

			<p class="warn-footnote">Quelle: NINA / Bund (warnung.bund.de) · Stand des letzten Seiten-Builds: {buildStamp}</p>
		</div>
	</div>

	<div class="day-modal" id="hazardModal" hidden>
		<div class="day-modal-backdrop" id="hazardModalBackdrop"></div>
		<div class="day-modal-panel hazard-modal-panel" role="dialog" aria-modal="true" aria-labelledby="hazardModalTitle">
			<button class="day-modal-close" id="hazardModalClose" aria-label="Schließen">
				<svg class="ic"><use href="#i-close"/></svg>
			</button>
			<h2 id="hazardModalTitle">Hochwassergefahrenkarte · Berlin</h2>
			<p class="hazard-sub">
				Amtliche Karte des Umweltatlas Berlin: Gewässerabschnitte, für die eine Hochwassergefahr amtlich ausgewiesen ist,
				in drei Wahrscheinlichkeits-Szenarien (häufig, mittel, extrem). Dunklere Blautöne zeigen eine größere Wassertiefe im jeweiligen Szenario.
			</p>
			<div class="hazard-map-wrap">
				<img class="hazard-layer" src="https://gdi.berlin.de/services/wms/alkis_bezirke?SERVICE=WMS&REQUEST=GetMap&VERSION=1.3.0&LAYERS=bezirksgrenzen&STYLES=&CRS=EPSG:4326&BBOX=52.33,13.08,52.68,13.76&WIDTH=900&HEIGHT=763&FORMAT=image/png&TRANSPARENT=TRUE" alt="Bezirksgrenzen Berlin" loading="lazy" />
				<img class="hazard-layer" src="https://gdi.berlin.de/services/wms/ua_hochwassergefahrenkarten?SERVICE=WMS&REQUEST=GetMap&VERSION=1.3.0&LAYERS=c_hwgk_niedrig,b_hwgk_mittel,a_hwgk_hoch&STYLES=,,&CRS=EPSG:4326&BBOX=52.33,13.08,52.68,13.76&WIDTH=900&HEIGHT=763&FORMAT=image/png&TRANSPARENT=TRUE" alt="Hochwassergefahrenkarte (Umweltatlas Berlin)" loading="lazy" />
			</div>
			<p class="warn-footnote">
				Quelle: <a href="https://www.berlin.de/umweltatlas/en/water/flood/" target="_blank" rel="noopener">Umweltatlas Berlin</a>
				(Senatsverwaltung für Stadtentwicklung, Bauen und Wohnen) · statische amtliche Gefahrenkarte, keine Live-Daten zu einem laufenden Einsatz ·
				<a href="https://www.berlin.de/umweltatlas/en/water/flood/" target="_blank" rel="noopener">Vollständige interaktive Karte öffnen ↗</a>
			</p>
		</div>
	</div>

	<script>
		import "../scripts/dashboard.js";
	</script>

	<style>
		:root {
			--bg: #1b2028;
			--panel: #20262e;
			--panel-2: #232a32;
			--text: #dfe6ec;
			--muted: #8a97a3;
			--accent: #22a67e;
			--series-weather: #22a67e;
			--series-pegel: #3987e5;
			--series-fire: #d95926;
			--status-good: #0ca30c;
			--status-warning: #fab219;
			--status-serious: #ec835a;
			--status-critical: #d03b3b;
			--chart-grid: rgba(255, 255, 255, 0.07);
			--radius: 20px;
			--shadow-out: 9px 9px 18px rgba(0, 0, 0, 0.5), -7px -7px 16px rgba(255, 255, 255, 0.025);
			--shadow-in: inset 4px 4px 10px rgba(0, 0, 0, 0.4), inset -3px -3px 8px rgba(255, 255, 255, 0.02);
		}

		* {
			box-sizing: border-box;
		}

		html,
		body {
			height: 100%;
			margin: 0;
			overflow: hidden;
			background: var(--bg);
			color: var(--text);
			font-family: "Nunito Sans", "Segoe UI", sans-serif;
		}

		body.modal-open {
			overflow: hidden;
		}

		.screen {
			height: 100dvh;
			width: 100%;
			padding: 18px 24px;
		}

		.layout {
			height: 100%;
			display: grid;
			grid-template-columns: 1.3fr 1fr 1fr 0.95fr;
			grid-template-rows: auto 1.2fr 0.68fr auto;
			grid-template-areas:
				"top top top top"
				"hero pegel fire warn"
				"chart chart resptime total"
				"forecast forecast forecast forecast";
			gap: 14px;
		}

		.ic {
			width: 16px;
			height: 16px;
			fill: none;
			stroke: currentColor;
			stroke-width: 1.8;
			stroke-linecap: round;
			stroke-linejoin: round;
			flex-shrink: 0;
		}

		.ic.sm {
			width: 13px;
			height: 13px;
		}

		.area-top {
			grid-area: top;
			display: flex;
			align-items: center;
			justify-content: space-between;
		}

		.place {
			display: flex;
			align-items: center;
			gap: 9px;
			font-weight: 700;
			font-size: 19px;
			color: var(--accent);
		}

		.timestamp {
			display: flex;
			align-items: center;
			gap: 8px;
			color: var(--muted);
			font-size: 14.5px;
			font-variant-numeric: tabular-nums;
		}

		.live-dot {
			width: 7px;
			height: 7px;
			border-radius: 50%;
			background: var(--accent);
			box-shadow: 0 0 0 3px rgba(34, 166, 126, 0.25);
		}

		.hero-block,
		.stat,
		.chart-box {
			background: var(--panel);
			border-radius: var(--radius);
			box-shadow: var(--shadow-out);
			min-height: 0;
			overflow: hidden;
		}

		.hero-block {
			grid-area: hero;
			padding: 18px 22px;
			display: flex;
			flex-direction: column;
			justify-content: center;
			gap: 7px;
		}

		.hero-top {
			display: flex;
			align-items: center;
			justify-content: space-between;
		}

		.temp-big {
			font-weight: 800;
			font-size: clamp(2.2rem, 4vw, 3.6rem);
			line-height: 1;
			letter-spacing: -0.02em;
		}

		.hero-icon {
			width: 52px;
			height: 52px;
			color: var(--series-weather);
			fill: none;
			stroke: currentColor;
			stroke-width: 1.6;
			stroke-linecap: round;
			stroke-linejoin: round;
		}

		.cond {
			font-size: 16.5px;
			color: var(--muted);
		}

		.minmax {
			display: flex;
			align-items: center;
			gap: 8px;
			font-size: 14px;
			color: var(--muted);
			font-variant-numeric: tabular-nums;
		}

		.chips {
			display: flex;
			flex-wrap: wrap;
			gap: 7px;
			margin-top: 4px;
		}

		.chip {
			display: inline-flex;
			align-items: center;
			gap: 6px;
			background: var(--bg);
			box-shadow: var(--shadow-in);
			border-radius: 999px;
			padding: 5px 11px;
			font-size: 12px;
			color: var(--muted);
			font-variant-numeric: tabular-nums;
		}

		.status {
			margin-top: auto;
			font-size: 11px;
			color: var(--muted);
			opacity: 0.75;
		}

		.stat {
			padding: 14px 18px;
			display: flex;
			flex-direction: column;
			gap: 4px;
		}

		.stat.s-pegel {
			grid-area: pegel;
			--icon-color: var(--series-pegel);
		}

		.stat.s-fire {
			grid-area: fire;
			--icon-color: var(--series-fire);
		}

		.stat.s-resptime {
			grid-area: resptime;
			--icon-color: var(--series-fire);
			padding: 12px 16px;
			gap: 3px;
		}

		.stack-col {
			display: flex;
			flex-direction: column;
			gap: 12px;
			min-height: 0;
		}

		.stat.tile-half {
			flex: 1;
			padding: 10px 16px;
			gap: 2px;
			min-height: 0;
			--icon-color: var(--muted);
			justify-content: center;
		}

		.tile-half-btn {
			border: none;
			font: inherit;
			color: var(--text);
			text-align: left;
			cursor: pointer;
			width: 100%;
			transition: box-shadow 0.15s ease, transform 0.15s ease;
		}

		.tile-half-btn:hover,
		.tile-half-btn:focus-visible {
			transform: translateY(-2px);
			box-shadow: var(--shadow-out), 0 0 0 2px var(--series-pegel);
			outline: none;
		}

		.hero-icon-col {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 8px;
			flex-shrink: 0;
		}

		.air-badge {
			display: inline-flex;
			align-items: center;
			gap: 5px;
			background: var(--bg);
			box-shadow: var(--shadow-in);
			border-radius: 999px;
			padding: 4px 10px 4px 8px;
			font-size: 11.5px;
			font-weight: 700;
			white-space: nowrap;
		}

		#aqiIcon {
			width: 12px;
			height: 12px;
		}

		.stat.s-warn {
			grid-area: warn;
			--icon-color: var(--muted);
			border: none;
			font: inherit;
			color: var(--text);
			text-align: left;
			cursor: pointer;
			width: 100%;
			transition: box-shadow 0.15s ease, transform 0.15s ease;
		}

		.stat.s-warn:hover,
		.stat.s-warn:focus-visible {
			transform: translateY(-2px);
			box-shadow: var(--shadow-out), 0 0 0 2px var(--series-fire);
			outline: none;
		}

		.warn-preview {
			display: flex;
			flex-direction: column;
			gap: 5px;
			margin-top: 4px;
			overflow: hidden;
			flex: 1;
		}

		.warn-preview p {
			font-size: 12.5px;
			color: var(--muted);
			margin: 0;
		}

		.warn-preview-item {
			display: flex;
			align-items: flex-start;
			gap: 7px;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
			color: var(--text) !important;
		}

		.warn-dot {
			width: 7px;
			height: 7px;
			border-radius: 50%;
			margin-top: 5px;
			flex-shrink: 0;
			background: var(--muted);
		}

		.warn-dot.aqi-good {
			background: var(--status-good);
		}
		.warn-dot.aqi-warning {
			background: var(--status-warning);
		}
		.warn-dot.aqi-serious {
			background: var(--status-serious);
		}
		.warn-dot.aqi-critical {
			background: var(--status-critical);
		}

		.stat .k {
			display: flex;
			align-items: center;
			gap: 7px;
			font-size: 11.5px;
			letter-spacing: 0.03em;
			text-transform: uppercase;
			color: var(--muted);
		}

		.stat .k .ic {
			color: var(--icon-color, var(--accent));
		}

		.stat .v {
			font-weight: 800;
			font-size: clamp(1.3rem, 2vw, 1.7rem);
			font-variant-numeric: tabular-nums;
		}

		.stat .v .unit {
			font-size: 0.5em;
			font-weight: 700;
			color: var(--muted);
			text-transform: uppercase;
			letter-spacing: 0.04em;
			margin-left: 4px;
		}

		.stat .sub {
			font-size: 12.5px;
			color: var(--muted);
		}

		.stat .sub.muted {
			opacity: 0.65;
			font-size: 11px;
		}

		.mini-chart {
			position: relative;
			flex: 1;
			min-height: 42px;
			margin: 2px 0;
		}

		.mini-chart svg {
			width: 100%;
			height: 100%;
			display: block;
		}

		.v.aqi-good {
			color: var(--status-good);
		}
		.v.aqi-warning {
			color: var(--status-warning);
		}
		.v.aqi-serious {
			color: var(--status-serious);
		}
		.v.aqi-critical {
			color: var(--status-critical);
		}
		.ic.aqi-good {
			color: var(--status-good);
		}
		.ic.aqi-warning {
			color: var(--status-warning);
		}
		.ic.aqi-serious {
			color: var(--status-serious);
		}
		.ic.aqi-critical {
			color: var(--status-critical);
		}

		.chart-box {
			grid-area: chart;
			padding: 10px 18px 8px;
			display: flex;
			flex-direction: column;
		}

		.chart-head {
			display: flex;
			justify-content: space-between;
			font-size: 12px;
			color: var(--muted);
			margin-bottom: 4px;
			flex-shrink: 0;
		}

		.chart-head b {
			color: var(--text);
			font-weight: 800;
			font-variant-numeric: tabular-nums;
		}

		.chart-wrap {
			position: relative;
			flex: 1;
			min-height: 0;
		}

		#weatherChart {
			width: 100%;
			height: 100%;
			display: block;
		}

		.chart-tooltip {
			position: absolute;
			pointer-events: none;
			transform: translate(-50%, -115%);
			background: var(--bg);
			box-shadow: var(--shadow-out);
			color: var(--text);
			padding: 6px 10px;
			border-radius: 10px;
			font-size: 12px;
			white-space: nowrap;
			font-variant-numeric: tabular-nums;
			z-index: 2;
		}

		.chart-tooltip[hidden] {
			display: none;
		}

		.forecast {
			grid-area: forecast;
			display: grid;
			grid-template-columns: repeat(7, 1fr);
			gap: 10px;
		}

		.forecast :global(.day) {
			background: var(--panel);
			border: none;
			border-radius: 16px;
			box-shadow: var(--shadow-out);
			padding: 9px 4px 8px;
			text-align: center;
			color: var(--text);
			font: inherit;
			cursor: pointer;
			display: flex;
			flex-direction: column;
			align-items: center;
			transition: box-shadow 0.15s ease, transform 0.15s ease;
		}

		.forecast :global(.day:hover),
		.forecast :global(.day:focus-visible) {
			transform: translateY(-2px);
			box-shadow: var(--shadow-out), 0 0 0 2px var(--series-weather);
			outline: none;
		}

		.forecast :global(.d) {
			font-size: 12px;
			font-weight: 700;
			color: var(--muted);
			margin-bottom: 5px;
		}

		.forecast :global(.ic) {
			width: 22px;
			height: 22px;
			color: var(--series-weather);
			margin: 0 auto 5px;
			display: block;
		}

		.forecast :global(.hi) {
			font-weight: 800;
			font-size: 14px;
			font-variant-numeric: tabular-nums;
		}

		.forecast :global(.lo) {
			font-size: 12px;
			color: var(--muted);
			font-variant-numeric: tabular-nums;
		}

		.forecast :global(.chev) {
			width: 13px;
			height: 13px;
			color: var(--muted);
			opacity: 0.6;
			margin-top: 4px;
		}

		/* ---------- Tages-Detail (Fokus-Ansicht der 7-Tage-Vorhersage) ---------- */

		.day-modal {
			position: fixed;
			inset: 0;
			z-index: 50;
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 20px;
		}

		.day-modal[hidden] {
			display: none;
		}

		.day-modal-backdrop {
			position: absolute;
			inset: 0;
			background: rgba(4, 8, 10, 0.6);
			backdrop-filter: blur(3px);
		}

		.day-modal-panel {
			position: relative;
			z-index: 1;
			width: min(440px, 100%);
			max-height: 90vh;
			overflow: auto;
			background: var(--panel);
			border-radius: 24px;
			box-shadow: 0 30px 70px rgba(0, 0, 0, 0.5);
			padding: 26px 24px 22px;
		}

		.day-modal-close {
			position: absolute;
			top: 14px;
			right: 14px;
			width: 34px;
			height: 34px;
			border-radius: 999px;
			border: none;
			background: var(--bg);
			box-shadow: var(--shadow-in);
			color: var(--text);
			cursor: pointer;
			display: grid;
			place-items: center;
		}

		.day-modal-head {
			display: flex;
			align-items: center;
			gap: 14px;
			margin-bottom: 10px;
		}

		.day-modal-icon {
			width: 46px;
			height: 46px;
			color: var(--series-weather);
			flex-shrink: 0;
		}

		.day-modal-date {
			font-weight: 800;
			font-size: 16.5px;
		}

		.day-modal-cond {
			color: var(--muted);
			font-size: 13.5px;
		}

		.day-modal-temps {
			display: flex;
			gap: 16px;
			font-size: 22px;
			font-weight: 800;
			margin: 12px 0 18px;
			font-variant-numeric: tabular-nums;
		}

		.day-modal-temps .hi,
		.day-modal-temps .lo {
			display: inline-flex;
			align-items: center;
			gap: 6px;
		}

		.day-modal-temps .lo {
			color: var(--muted);
			font-weight: 700;
		}

		.day-modal-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 10px;
		}

		.dm-stat {
			background: var(--bg);
			box-shadow: var(--shadow-in);
			border-radius: 14px;
			padding: 10px 12px;
		}

		.dm-k {
			font-size: 11px;
			text-transform: uppercase;
			letter-spacing: 0.03em;
			color: var(--muted);
			margin-bottom: 4px;
		}

		.dm-v {
			font-weight: 800;
			font-size: 15px;
			font-variant-numeric: tabular-nums;
		}

		/* ---------- Warnungen-Modal ---------- */

		.warn-modal-panel {
			width: min(560px, 100%);
		}

		.warn-modal-panel h2 {
			font-size: 17px;
			font-weight: 800;
			margin-bottom: 14px;
			padding-right: 30px;
		}

		.warn-empty {
			color: var(--muted);
			font-size: 14px;
			line-height: 1.5;
		}

		.warn-empty a {
			color: var(--series-weather);
		}

		.warn-list {
			display: flex;
			flex-direction: column;
			gap: 12px;
		}

		.warn-card {
			background: var(--bg);
			box-shadow: var(--shadow-in);
			border-radius: 16px;
			padding: 14px 16px;
		}

		.warn-card-head {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 10px;
			margin-bottom: 8px;
		}

		.warn-badge {
			font-size: 11px;
			font-weight: 800;
			letter-spacing: 0.03em;
			text-transform: uppercase;
			padding: 3px 9px;
			border-radius: 999px;
		}

		.warn-badge.aqi-good {
			background: rgba(12, 163, 12, 0.18);
			color: var(--status-good);
		}
		.warn-badge.aqi-warning {
			background: rgba(250, 178, 25, 0.18);
			color: var(--status-warning);
		}
		.warn-badge.aqi-serious {
			background: rgba(236, 131, 90, 0.18);
			color: var(--status-serious);
		}
		.warn-badge.aqi-critical {
			background: rgba(208, 59, 59, 0.2);
			color: var(--status-critical);
		}

		.warn-time {
			font-size: 11.5px;
			color: var(--muted);
			white-space: nowrap;
		}

		.warn-card h3 {
			font-size: 15px;
			font-weight: 800;
			margin-bottom: 6px;
			text-wrap: balance;
		}

		.warn-desc,
		.warn-instr {
			font-size: 13.5px;
			color: var(--text);
			line-height: 1.5;
			margin-bottom: 8px;
		}

		.warn-instr {
			color: var(--muted);
		}

		.warn-meta {
			font-size: 11.5px;
			color: var(--muted);
			opacity: 0.8;
		}

		.warn-footnote {
			margin-top: 16px;
			font-size: 11px;
			color: var(--muted);
			opacity: 0.7;
			line-height: 1.4;
		}

		.warn-footnote a {
			color: var(--series-pegel);
			opacity: 1;
		}

		/* ---------- Gefahrenkarte-Modal ---------- */

		.hazard-modal-panel {
			width: min(720px, 100%);
		}

		.hazard-modal-panel h2 {
			font-size: 17px;
			font-weight: 800;
			margin-bottom: 8px;
			padding-right: 30px;
		}

		.hazard-sub {
			font-size: 13px;
			color: var(--muted);
			line-height: 1.5;
			margin-bottom: 14px;
		}

		.hazard-map-wrap {
			position: relative;
			width: 100%;
			aspect-ratio: 900 / 763;
			background: #eef2f5;
			border-radius: 14px;
			overflow: hidden;
		}

		.hazard-layer {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
		}

		/* ---------- Responsive: Tablet ---------- */

		@media (max-width: 1100px) {
			html,
			body {
				height: auto;
				overflow: visible;
			}

			.screen {
				height: auto;
				min-height: 100dvh;
				padding: 16px 18px 26px;
			}

			.layout {
				height: auto;
				grid-template-columns: 1fr 1fr;
				grid-template-rows: none;
				grid-template-areas:
					"top top"
					"hero hero"
					"pegel fire"
					"warn warn"
					"chart chart"
					"resptime total"
					"forecast forecast";
				gap: 12px;
			}

			.mini-chart {
				flex: none;
				height: 110px;
			}

			.chart-box {
				height: 220px;
				padding: 14px 18px 10px;
			}

			.stat.s-resptime {
				min-height: 130px;
			}

			.stack-col {
				min-height: 220px;
			}

			.forecast {
				grid-template-columns: repeat(4, 1fr);
				gap: 10px;
			}
		}

		/* ---------- Responsive: Smartphone ---------- */

		@media (max-width: 640px) {
			.screen {
				padding: 12px 14px 22px;
			}

			.layout {
				grid-template-columns: 1fr;
				grid-template-areas:
					"top"
					"hero"
					"pegel"
					"fire"
					"warn"
					"chart"
					"resptime"
					"total"
					"forecast";
				gap: 10px;
			}

			.area-top {
				flex-wrap: wrap;
				gap: 6px;
				row-gap: 4px;
			}

			.place {
				font-size: 17px;
			}

			.timestamp {
				font-size: 12.5px;
				flex-wrap: wrap;
			}

			.temp-big {
				font-size: 2.6rem;
			}

			.mini-chart {
				height: 90px;
			}

			.chart-box {
				height: 190px;
			}

			.forecast {
				grid-template-columns: repeat(3, 1fr);
			}

			.day-modal-grid {
				grid-template-columns: 1fr;
			}
		}
	</style>
</body>
</html>
